programa {
  funcao inicio() {
    inteiro numero
    inteiro soma = 0
    escreva("Digite um numero ou 0 para finalizar ")
    leia(numero)

    enquanto(numero != 0){
      soma = soma + numero
      escreva("digite outro numero ")
      leia(numero)
      
    }
    escreva("\n A soma total é: ", soma)
  }
}
